{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "fixed",
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:component",
          "predicate": "minecraft:custom_data",
          "value": {
            "compliance": {
              "special_item_frame_model": {
                "toggle": true
              }
            }
          },
          "on_true": {
            "type": "minecraft:model",
            "model": "mixedbag:item/mortar_3d"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "mixedbag:item/mortar"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:model",
        "model": "mixedbag:item/mortar_use"
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "mixedbag:item/mortar"
      }
    }
  }
}